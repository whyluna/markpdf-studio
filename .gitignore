# Xcode
build/
DerivedData/
*.xcuserstate
xcuserdata/
*.xcscmblueprint
*.xccheckout

# XcodeGen 生成的工程文件（不入库，克隆后运行 xcodegen generate 生成）
MarkPDF.xcodeproj/

# SwiftPM
.swiftpm/
.build/

# Web 内核（Node）：依赖与构建产物不入库；保留 dist/.gitkeep 占位使 xcodegen 校验通过
MarkPDF/Resources/Web/node_modules/
MarkPDF/Resources/Web/dist/*
!MarkPDF/Resources/Web/dist/.gitkeep

# macOS
.DS_Store

# 测试用本地 DerivedData（避免污染用户全局 DerivedData）
.dd/
